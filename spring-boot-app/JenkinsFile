pipeline {
  agent {
    docker {
      image 'jibin321/maven-docker-agent:v2'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
    }
  }

  environment {
    DOCKER_IMAGE = "salmanulfaris2395/spring-boot-app/:${BUILD_NUMBER}"
    GIT_REPO_NAME = "java-maven-sonar-argocd"
    GIT_USER_NAME = "salmanulfaris2332"
  }

  options {
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }

  stages {

    stage('Checkout') {
      steps {
        sh 'echo "Checkout successful"'
        sh 'ls -ltr'
      }
    }

    stage('SonarQube Analysis') {
      steps {
        script {
          def scannerHome = tool 'sonarscanner'

          withSonarQubeEnv('sonarqube') {
            sh """
              ${scannerHome}/bin/sonar-scanner \
                -Dsonar.projectKey=springboot-app-test \
                -Dsonar.projectName='springboot-app-test-website' \
                -Dsonar.sources=src \
                -Dsonar.sourceEncoding=UTF-8
            """
          }
        }
      }
    }

    stage('Build and Push Docker Image') {
      steps {
        script {

          sh 'docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} .'

          def dockerImage = docker.image("${DOCKER_IMAGE}:${BUILD_NUMBER}")

          docker.withRegistry(
            'https://index.docker.io/v1/',
            'docker-cred'
          ) {
            dockerImage.push()
            dockerImage.push('latest')
          }
        }
      }
    }

    stage('Update Deployment File') {
      steps {
        withCredentials([
          string(
            credentialsId: 'github',
            variable: 'GITHUB_TOKEN'
          )
        ]) {

          sh '''
            git config user.email "sidharthshai98@gmail.com"
            git config user.name "${GIT_USER_NAME}"

            sed -i "s|image: .*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|g" k8s/deployment.yml

            git add k8s/deployment.yml

            git commit -m "Update static website image to ${BUILD_NUMBER} [skip ci]" || echo "No changes to commit"

            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
          '''
        }
      }
    }
  }

  post {
    always {
      cleanWs()
    }
  }
}
