pipeline {
  agent {
    docker {
      image 'jibin321/maven-docker-agent:v2'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
    }
  }
  environment {
    DOCKER_IMAGE   = "salmanulfaris2395/spring-boot-app"
    GIT_REPO_NAME  = "java-maven-sonar-argocd"
    GIT_USER_NAME  = "salmanulfaris2332"
    APP_DIR        = "spring-boot-app"
  }
  options {
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }
  stages {
    stage('Checkout') {
      steps {
        sh 'echo "Checkout successful"'
        sh 'ls -ltr'
      }
    }

    stage('Build and Test') {
      steps {
        dir("${APP_DIR}") {
          sh 'mvn clean package'
        }
      }
    }

    stage('SonarQube Analysis') {
      steps {
        dir("${APP_DIR}") {
          withSonarQubeEnv('sonarqube') {
            sh '''
              mvn org.sonarsource.scanner.maven:sonar-maven-plugin:3.9.1.2184:sonar \
                -Dsonar.projectKey=spring-boot-app \
                -Dsonar.projectName='Spring Boot App'
            '''
          }
        }
      }
    }

    stage('Build and Push Docker Image') {
      steps {
        dir("${APP_DIR}") {
          script {
            sh 'docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} .'
            def dockerImage = docker.image("${DOCKER_IMAGE}:${BUILD_NUMBER}")
            docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
              dockerImage.push()
              dockerImage.push('latest')
            }
          }
        }
      }
    }

    stage('Update Deployment File') {
      steps {
        withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
          sh '''
            git config --global --add safe.directory "$WORKSPACE"
            git config user.email "salmanulfaris2332@gmail.com"
            git config user.name "${GIT_USER_NAME}"
            sed -i "s|image: .*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|g" spring-boot-app-manifests/deployment.yml
            git add spring-boot-app-manifests/deployment.yml
            git commit -m "Update spring-boot app image to ${BUILD_NUMBER} [skip ci]" || echo "No changes to commit"
            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
          '''
        }
      }
    }
  }

  post {
    always {
      cleanWs()
    }
  }
}
