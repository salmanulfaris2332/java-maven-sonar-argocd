pipeline {
  agent {
    docker {
      image 'jibin321/maven-docker-agent:v2'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
    }
  }

  environment {
    DOCKER_IMAGE = "salmanulfaris2395/spring-boot-app"
    GIT_REPO_NAME = "java-maven-sonar-argocd"
    GIT_USER_NAME = "salmanulfaris2332"
  }

  options {
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }

  stages {

    stage('Checkout') {
      steps {
        sh 'echo "Checkout successful"'
        sh 'ls -ltr'
      }
    }

    stage('SonarQube Analysis') {
      steps {
        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
          sh '''
            cd spring-boot-app && mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
              -Dsonar.login=$SONAR_AUTH_TOKEN \
              -Dsonar.host.url=http://13.204.83.62:9000 \
              -Dsonar.projectKey=springboot-app-test \
              -Dsonar.projectName='springboot-app-test-website'
          '''
        }
      }
    }

    // FIXED: Added the missing build step to compile the Java .jar file
    stage('Build Application') {
      steps {
        sh 'cd spring-boot-app && mvn clean package'
      }
    }

    stage('Build and Push Docker Image') {
      steps {
        script {
          sh "cd spring-boot-app && docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} ."

          def dockerImage = docker.image("${DOCKER_IMAGE}:${BUILD_NUMBER}")

          docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
            dockerImage.push()
            dockerImage.push('latest')
          }
        }
      }
    }

    stage('Update Deployment File') {
      steps {
        withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
          sh '''
            git config user.email "sidharthshai98@gmail.com"
            git config user.name "${GIT_USER_NAME}"

            sed -i "s|image: .*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|g" spring-boot-app-manifests/deployment.yml

            git add spring-boot-app-manifests/deployment.yml

            git commit -m "Update static website image to ${BUILD_NUMBER} [skip ci]" || echo "No changes to commit"

            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
          '''
        }
      }
    }
  }

  post {
    always {
      cleanWs()
    }
  }
}
